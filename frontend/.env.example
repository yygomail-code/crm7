# Адрес API по умолчанию — относительный (./api/v2), чтобы сборка работала из любого подкаталога.
# Для локальной разработки абсолютный адрес задаётся в .env.development.
# Для конкретного стенда можно переопределить в public/config.js (window.CRM_CONFIG.apiV2Base)
# или переменными VITE_API_V2_BASE / VITE_API_BASE при сборке.
VITE_API_BASE=./back/index.php
